import java.util.*;
import java.io.*;

// n(n+1)/2 이 n쌍의 괄호가 가지는 이동횟수의 최대값
// ))(( <- 가장 많은 이동횟수 필요
// 이것보다 작으려면 '(' 이것이 왼쪽으로 이동하는게 더 적은 이동횟수를 가짐
// 그렇기에 n(n-1)/2 <n < n(n+1)/2  이 범위 안 이라면 '('를 이동시켜가며 문자열을 찾는 것!

public class Solution {

    public static void main(String[] args) throws Exception{
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int T = Integer.parseInt(br.readLine());
        StringBuilder answer = new StringBuilder();

        for(int tc = 1; tc<T+1; tc++){
            int A = Integer.parseInt(br.readLine());

            // 조건을 만족하는 가장 작은 n 찾기
            long n = 1;
            while(true){
                if (n*(n+1)/2 >= A) break;
                n++;
            }

            //n으로 낼 수 있는 최대 횟수와 목표치의 차이 구하기
            long maxSwaps = n * (n+1) / 2;
            long E = maxSwaps - A;

            // 넣을 문자열
            StringBuilder sb = new StringBuilder();
            
            // '(' (n-E)개
            for (long i =0; i <n-E; i++){
                sb.append(')');
            }
            // '(' 1개 -> 2개 이상되면 A보다 작은 횟수만에 완성되어버림
            sb.append('(');
            
            // '('를 E개 출력
            for (long i =0; i<E; i++){
                sb.append(')');
            }
            // ')'를 n-1 개 출력
            for (long i = 0; i< n-1; i++){
                sb.append('(');
            }
            answer.append('#').append(tc).append(" ").append(sb).append("\n");
        }
        System.out.println(answer);
    }
}
